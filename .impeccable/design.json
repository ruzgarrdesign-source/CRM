  "components": [
    {
      "name": "Primary Button",
      "kind": "button",
      "refersTo": "button-primary",
      "description": "Main review or form action.",
      "html": "<button class=\"ds-btn-primary\">Raporu onayla</button>",
      "css": ".ds-btn-primary{display:inline-flex;align-items:center;justify-content:center;min-height:36px;padding:9px 13px;border:0;border-radius:6px;background:var(--accent,#255e4f);color:#fff;font:600 12px/1.5 'Segoe UI',Arial,sans-serif;cursor:pointer;transition:background .16s}.ds-btn-primary:hover{background:var(--accent-hover,#194638)}.ds-btn-primary:focus-visible{outline:3px solid #499a86;outline-offset:3px}.ds-btn-primary:disabled{opacity:.48;cursor:not-allowed}"
    },
    {
      "name": "Secondary Button",
      "kind": "button",
      "refersTo": "button-secondary",
      "description": "Less prominent review or navigation action.",
      "html": "<button class=\"ds-btn-secondary\">Revizyon iste</button>",
      "css": ".ds-btn-secondary{display:inline-flex;align-items:center;justify-content:center;min-height:36px;padding:9px 13px;border:1px solid #cbd6ce;border-radius:6px;background:#fff;color:#3b544b;font:600 12px/1.5 'Segoe UI',Arial,sans-serif;cursor:pointer;transition:background .16s}.ds-btn-secondary:hover{background:#eff4ef}.ds-btn-secondary:focus-visible{outline:3px solid #499a86;outline-offset:3px}"
    },
    {
      "name": "Navigation Item",
      "kind": "nav",
      "refersTo": "nav-active",
      "description": "Selected rail destination.",
      "html": "<nav class=\"ds-nav\"><button class=\"ds-nav-item\">İnceleme</button></nav>",
      "css": ".ds-nav{width:204px;padding:16px;background:var(--nav,#173d3a)}.ds-nav-item{width:100%;padding:11px 13px;border:0;border-radius:7px;background:#dce8da;color:#193d33;text-align:left;font:600 13px/1.5 'Segoe UI',Arial,sans-serif;cursor:pointer}.ds-nav-item:hover{background:#edf3e9}.ds-nav-item:focus-visible{outline:3px solid #499a86;outline-offset:3px}"
    },
    {
      "name": "Pending Status",
      "kind": "chip",
      "refersTo": "status-pending",
      "description": "Text and dot status for a submitted report.",
      "html": "<span class=\"ds-pill-pending\">İncelemede</span>",
      "css": ".ds-pill-pending{display:inline-flex;align-items:center;gap:5px;padding:3px 7px;border-radius:4px;background:#fbf1db;color:var(--amber,#895b1e);font:500 10px/1.4 'Segoe UI',Arial,sans-serif;white-space:nowrap}.ds-pill-pending:before{content:'';width:4px;height:4px;border-radius:50%;background:currentColor}"
    },
    {
      "name": "Panel",
      "kind": "card",
      "refersTo": "panel",
      "description": "White bordered working surface.",
      "html": "<section class=\"ds-panel\"><h2>Rapor bilgileri</h2><p>Rapor ayrıntıları</p></section>",
      "css": ".ds-panel{padding:25px;border:1px solid var(--border,#e1e7e3);border-radius:10px;background:var(--paper,#fff);color:var(--ink,#253b39);font:14px/1.5 'Segoe UI',Arial,sans-serif}.ds-panel h2{margin:0 0 20px;font-size:19px;line-height:1.3;letter-spacing:-.015em}.ds-panel p{margin:0}"
    },
    {
      "name": "Search Field",
      "kind": "input",
      "description": "Queue search input with single outlined shell.",
      "html": "<label class=\"ds-search\"><svg width=\"18\" height=\"18\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.65\" stroke-linecap=\"round\" aria-hidden=\"true\"><circle cx=\"11\" cy=\"11\" r=\"7\"/><path d=\"m16 16 5 5\"/></svg><input type=\"search\" placeholder=\"Rapor veya çalışan ara...\" aria-label=\"Rapor veya çalışan ara\"></label>",
      "css": ".ds-search{display:flex;align-items:center;gap:8px;max-width:255px;padding:0 10px;border:1px solid var(--border,#e1e7e3);border-radius:6px;background:#fff;color:#7a8982}.ds-search input{width:100%;min-width:0;padding:9px 0;border:0;outline:0;background:none;color:var(--ink,#253b39);font:12px/1.5 'Segoe UI',Arial,sans-serif}.ds-search:focus-within{outline:3px solid #499a86;outline-offset:3px}"
