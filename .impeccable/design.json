  "narrative": {
    "northStar": "Contact-Sheet Precision",
    "overview": "The shipped Operate prototype makes the report image and the review decision the main work. A dark navigation rail anchors a light, dense workspace. White panes, thin dividers, restrained state color, and a cool image mat let users scan a queue while keeping the current image large.\n\nThe interface uses ordinary controls and aligned metadata. The contact strip tracks the selected image below the viewer; report state remains readable in words and color. The visual system describes this browser-local demo, not a settled product brand.",
    "keyCharacteristics": [
      "Desktop-first, three-area review workspace.",
      "Compact Segoe UI hierarchy and small operational metadata.",
      "Dark teal navigation against white working surfaces.",
      "Contact-strip selection and text-labeled semantic states."
    ],
    "rules": [
      {
        "name": "The State-With-Text Rule",
        "body": "A semantic tint accompanies an explicit status label; color alone never communicates report state.",
        "section": "colors"
      },
      {
        "name": "The Metadata Alignment Rule",
        "body": "Keep short labels and values in stable rows; the report detail uses an `80px 1fr` definition list, widened to `90px 1fr` below `850px`.",
        "section": "typography"
      },
      {
        "name": "The Image-First Rule",
        "body": "In review, preserve enough flexible area for the submitted image while keeping queue selection and the report decision reachable.",
        "section": "layout"
      }
    ],
    "dos": [
      "Do give the selected image a large, contained viewer and a visible contact strip.",
      "Do pair all status colors with written state labels.",
      "Do use the documented breakpoints and preserve reading order when review columns stack."
    ],
    "donts": [
      "Don't use shadows as the main pane-separation device; borders and tonal surfaces do that work."
    ]
  }
}
