      "css": ".ds-thumb{position:relative;width:66px;height:64px;padding:3px;border:2px solid #376e56;border-radius:6px;background:#edf4e9;cursor:pointer}.ds-thumb span{position:absolute;right:3px;bottom:3px;padding:0 3px;border-radius:2px;background:#fff;color:#315745;font:8px/1.4 'Segoe UI',Arial,sans-serif}.ds-thumb:hover{background:#e6efe4}.ds-thumb:focus-visible{outline:3px solid #499a86;outline-offset:3px}"
    }
